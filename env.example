# MapTools 项目环境配置示例
# 复制此文件为 .env 并修改相应的配置值

# MongoDB配置（用于道路数据分类存储）
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DATABASE=MapTools
MONGODB_COLLECTION_ROADS=道路数据
MONGODB_COLLECTION_NON_ROADS=非道路数据

# 道路分类配置
ROAD_CLASSIFICATION_ENABLED=true
ROAD_CLASSIFICATION_BATCH_SIZE=1000
ROAD_CLASSIFICATION_PROGRESS_UPDATE_INTERVAL=100

# 文件处理配置
GEOJSON_FILE_PATH=map.geojson
MAX_FILE_SIZE_MB=1000

# MapTools 后端服务环境配置示例
# 复制此文件为 .env 并修改相应的配置值

# 应用基础配置
APP_NAME=MapTools Backend Service
APP_VERSION=0.1.0
DEBUG=false

# 数据库配置
DATABASE_URL=mysql://gisuser:mysecretpassword@localhost:3306/gisdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# MongoDB配置（用于道路数据分类存储）
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DATABASE=MapTools
MONGODB_COLLECTION_ROADS=道路数据
MONGODB_COLLECTION_NON_ROADS=非道路数据

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# 天地图API配置（必需）
TIANDITU_API_KEY=your_tianditu_api_key_here
TIANDITU_WGS84_URL=http://t0.tianditu.gov.cn/vec_c/wmts
TIANDITU_WEB_MERCATOR_URL=http://t0.tianditu.gov.cn/vec_w/wmts

# 文件上传配置
UPLOAD_DIR=UserUploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=[".gpx", ".kml", ".csv", ".txt"]

# 匹配算法配置
DEFAULT_ALGORITHM=distance_matching
MATCHING_MAX_DISTANCE=1000.0
MATCHING_USE_SPEED_FILTER=true
MATCHING_MAX_SPEED=200.0

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=Logs
LOG_MAX_SIZE=104857600
LOG_BACKUP_COUNT=10

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]

# API配置
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

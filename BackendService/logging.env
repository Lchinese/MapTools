# 日志系统环境配置
# 根据日志系统设计文档配置

# 环境设置
ENVIRONMENT=development
DEBUG=true

# 日志级别配置
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed

# 日志输出配置
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_TO_DATABASE=false

# 日志轮转配置
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_RETENTION_DAYS=30

# 性能配置
LOG_ASYNC=true
LOG_BUFFER_SIZE=10MB
LOG_FLUSH_INTERVAL=5

# 安全配置
LOG_MASK_SENSITIVE=true
LOG_AUDIT_ENABLED=true

# 监控配置
LOG_METRICS_ENABLED=true
LOG_ALERT_ENABLED=true

# 数据库日志配置
LOG_DB_TABLE=system_logs
LOG_DB_BATCH_SIZE=10

# 远程日志配置
LOG_REMOTE_URL=
LOG_REMOTE_TIMEOUT=5

# 文件路径配置
LOG_APP_PATH=logs/app
LOG_ERROR_PATH=logs/error
LOG_MATCHING_PATH=logs/matching
LOG_API_PATH=logs/api
LOG_BUSINESS_PATH=logs/business
LOG_CELERY_PATH=logs/celery
LOG_UTILS_PATH=logs/utils
LOG_AUDIT_PATH=logs/audit
LOG_PERFORMANCE_PATH=logs/performance
